#cloud-config
hostname: {{ vm.name }}
fqdn: {{ vm.name }}.site-{{ site_id }}.lab
manage_etc_hosts: true
users:
  - name: {{ vm_user }}
    gecos: Infrastructure lab automation
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: false
    # Deterministic salt keeps the seed stable between runs.
    passwd: "{{ vm_console_password | password_hash('sha512', (vm.name | hash('sha1'))[:16]) }}"
    ssh_authorized_keys:
      - {{ lookup('ansible.builtin.file', secrets_dir ~ '/infra_ed25519.pub') }}
ssh_pwauth: false
disable_root: true
package_update: false
package_upgrade: false
